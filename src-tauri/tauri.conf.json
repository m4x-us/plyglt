{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "plyglt",
  "version": "0.1.0",
  "identifier": "app.plyglt",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3050",
    "beforeDevCommand": "npm run dev -- -p 3050"
  },
  "app": {
    "windows": [
      {
        "title": "plyglt",
        "width": 960,
        "height": 720,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.lemonsqueezy.com ipc: http://ipc.localhost; font-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: John Schmidt (RV5FNNH8L4)"
    },
    "windows": {
      "signCommand": "artifact-signing-cli -e %AZURE_SIGNING_ENDPOINT% -a %AZURE_SIGNING_ACCOUNT% -c %AZURE_SIGNING_PROFILE% -d plyglt %1"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQTJGQ0Q5MTVDQ0JGMzIKUldReXY4d1YyZnlpUTBYbjRMMjhzNVdoZ3lBbmo2Zk9jbmNyeGdUY1ZrWURiNHZmOUQ2WVJEelkK",
      "endpoints": [
        "https://github.com/m4x-us/plyglt/releases/latest/download/latest.json"
      ]
    }
  }
}
